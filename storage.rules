rules_version = '2';

// Regras do Storage — Quattro Construtora
// Como aplicar: Console do Firebase > Storage > Regras > colar > Publicar.
// Troque COLE_AQUI_O_UID_DO_ADMIN pelo mesmo UID usado em firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['bCipaHliVxSPqKIaQFBAKDamZ872'];
    }

    function imagemValida() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif|gif)')
        && request.resource.size < 10 * 1024 * 1024;
    }

    function videoValido() {
      return request.resource.contentType.matches('video/(mp4|webm)')
        && request.resource.size < 60 * 1024 * 1024;
    }

    // Arquivos enviados pelo /admin: leitura pública (aparecem no site);
    // gravar só o admin, só imagem/vídeo e dentro do limite de tamanho.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && (imagemValida() || videoValido());
      allow delete: if isAdmin();
    }

    function curriculoValido() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Currículos enviados pelo formulário "Trabalhe Conosco": qualquer visitante
    // pode ENVIAR (só PDF/DOC/DOCX até 10MB); a leitura é só do admin (dados pessoais).
    match /curriculos/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if curriculoValido();
      allow update, delete: if isAdmin();
    }

    // Demais arquivos: leitura pública, nenhuma gravação.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
