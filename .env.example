# Copie para .env.local (NÃO versionar) e preencha com os dados do projeto Firebase
# (Console > Configurações do projeto > Seus apps > Configuração do SDK).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
